---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface MediaItem {
  type: string;
  src: string;
  alt?: string;
  autoplay?: boolean;
  poster?: string;
}
interface Props { media?: MediaItem; fallback?: string; eager?: boolean; }
const { media, fallback = 'PAULINA', eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function localUrl(path?: string): string {
  if (!path || !/^\/media\/[a-zA-Z0-9_./-]+$/.test(path) || path.split('/').includes('..')) return '';
  return existsSync(join(process.cwd(), 'public', path.slice(1))) ? `${base}${path}` : '';
}
function youtubeId(raw?: string): string | null {
  if (!raw) return null;
  try {
    const url = new URL(raw);
    if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;
    const host = url.hostname.toLowerCase();
    let id: string | undefined;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1];
    else if (['youtube.com', 'www.youtube.com', 'm.youtube.com', 'youtube-nocookie.com', 'www.youtube-nocookie.com'].includes(host)) {
      id = url.searchParams.get('v') ?? url.pathname.match(/^\/(?:embed|shorts|live)\/([\w-]{11})\/?$/)?.[1] ?? undefined;
    }
    return id && /^[\w-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const imageUrl = media?.type === 'image' ? localUrl(media.src) : '';
const videoUrl = media?.type === 'video' ? localUrl(media.src) : '';
const ytId = media?.type === 'youtube' ? youtubeId(media.src) : null;
const posterUrl = localUrl(media?.poster);
const playable = Boolean(videoUrl || ytId);
const videoLabel = media?.alt || 'Play introduction video';
---
{imageUrl ? (
  <img src={imageUrl} alt={media?.alt ?? ''} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
) : playable && posterUrl ? (
  <div class="media-player" data-media-player data-video-url={videoUrl || undefined} data-youtube-id={ytId || undefined}>
    <img src={posterUrl} alt={media?.alt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <button type="button" class="media-play" aria-label={videoLabel}>
      <svg viewBox="0 0 24 24" width="27" height="27" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
    </button>
  </div>
) : videoUrl ? (
  <video controls playsinline preload="none" poster={posterUrl || undefined}><source src={videoUrl} type="video/mp4" /></video>
) : (
  <div class="media-fallback" role="img" aria-label={fallback}><span>{fallback}</span></div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-media-player]').forEach(container => {
    const button = container.querySelector<HTMLButtonElement>('.media-play');
    button?.addEventListener('click', () => {
      const url = container.dataset.videoUrl;
      const id = container.dataset.youtubeId;
      if (url) {
        const video = document.createElement('video');
        video.controls = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.src = url;
        video.setAttribute('aria-label', button.getAttribute('aria-label') || 'Introduction video');
        container.replaceChildren(video);
        void video.play().catch(() => {});
      } else if (id) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = button.getAttribute('aria-label') || 'Introduction video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        container.replaceChildren(iframe);
      }
    }, { once: true });
  });
</script>
