---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
interface Props { media?: {type: string; src: string; alt?: string; autoplay?: boolean; poster?: string}; fallback?: string; eager?: boolean; }
const {media, fallback='PAULINA', eager=false}=Astro.props;
const safe = media?.src?.startsWith('/media/') && !media.src.includes('..');
const exists = safe && existsSync(join(process.cwd(),'public',media!.src.slice(1)));
const url = exists ? `${import.meta.env.BASE_URL.replace(/\/$/,'')}${media!.src}` : '';
---
{exists && media?.type === 'video'
  ? <video controls={!media.autoplay} autoplay={!!media.autoplay} muted={!!media.autoplay} loop={!!media.autoplay} playsinline preload="metadata" poster={media.poster}><source src={url}/></video>
  : exists && media?.type === 'image'
    ? <img src={url} alt={media.alt ?? ''} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async"/>
    : <div class="media-fallback" role="img" aria-label={fallback}><span>{fallback}</span></div>}
